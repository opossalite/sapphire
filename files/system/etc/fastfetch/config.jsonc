{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/ublue-os/sapphireos-logo.txt",
        "color": {
            "1": "#1e1e2e",
            "2": "#313244",
            "3": "#45475a",
            "4": "#585b70",
            "5": "#89b4fa",
            "6": "#74c7ec",
            "7": "#94e2d5",
            "8": "#cba6f7",
            "9": "#cdd6f4"
        },
        "padding": {
            "right": 4
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
